<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- pleos.car.permission.* 권한은 승인 범위 확인 후 필요한 것만 추가한다. -->

    <!--
        실차 신호(003): AAOS 표준 권한 두 개만 선언한다. 속도(PERF_VEHICLE_SPEED)는 CAR_SPEED(dangerous, 런타임 요청),
        기어(GEAR_SELECTION)는 CAR_POWERTRAIN(normal). 이 이미지에는 pleos.car.permission.CAR_SPEED 가 없다.
        [확인 필요] 대회 측이 android.car.permission.* 선언을 허용하는지(헌장 IV, specs/003-real-vehicle-signal/plan.md Complexity Tracking).
    -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 음성(TTS) 합성. 승인 여부 [확인 필요]: 거부돼도 앱은 음성 없이 동작한다(specs/004 FR-015) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DashPet">

        <!-- 로터리(CCP) 미지원: 터치만으로 모든 기능이 동작해야 한다. -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />

        <!--
            [확인 필요] screenOrientation 은 의도적으로 지정하지 않는다.
            가로(2 윈도우)와 세로(1 윈도우) 모두 반응형으로 지원할 예정이다.
            (미지정 시 세로로 열린다. 화면 크기 변경 시 상태 보존/복원 필요)
        -->
        <!--
            configChanges: 화면 회전, 분할 크기, 밀도 같은 설정 변경에 Activity 를 다시 만들지 않는다(Compose 가 새 설정으로 다시 그린다).
            다시 만들면 onStop → onStart 가 와서 실차 신호 수신이 끊겼다 다시 열리고 엔진 상태가 초기화된다(003, FR-018).
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden|layoutDirection|fontScale|locale"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
